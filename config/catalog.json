{
  "node_types": [
  {
    "type": "core/start",
    "id": "72f8e409-bf15-4dd6-ab8c-70a2ec512ec7",
    "name": "Start Path",
    "category": "workflow",
    "subcategory": "start",
    "kind": "WORKFLOW_NODE_KIND_START",
    "description": "Where the run begins. The input type of this is path, which translates to a file on a drive",
    "control": { "in": [], "out": ["next"] },
    "dataOut": [
      { "name": "path", "label": "Path", "type": "path", "description": "The configured path." }
    ],
    "settings": [
      {
        "name": "trigger",
        "label": "Trigger",
        "type": "any",
        "default": "manual",
        "ui": { "widget": "dropdown", "options": ["manual", "schedule", "scanComplete"] },
        "description": "What starts this workflow. Only manual is honoured today; the rest are reserved."
      }
    ],
    "exec": { "runsOn": "server", "effects": "WORKFLOW_EFFECTS_READ" }
  },
  {
    "type": "core/start",
    "id": "df1084cd-e619-4af2-9214-048898acc479",
    "name": "Start Media",
    "category": "workflow",
    "subcategory": "start",
    "kind": "WORKFLOW_NODE_KIND_START",
    "description": "Where the run begins. The input type of this is media, media is a database record in mongo",
    "control": { "in": [], "out": ["next"] },
    "dataOut": [
      { "name": "media", "label": "Media Record", "type": "media", "description": "The media record." }
    ],
    "settings": [
      {
        "name": "trigger",
        "label": "Trigger",
        "type": "any",
        "default": "manual",
        "ui": { "widget": "dropdown", "options": ["manual", "schedule", "scanComplete"] },
        "description": "What starts this workflow. Only manual is honoured today; the rest are reserved."
      }
    ],
    "exec": { "runsOn": "server", "effects": "WORKFLOW_EFFECTS_READ" }
  },
  {
    "type": "core/errorOutput",
    "id": "f71e846a-2015-4d2d-99f1-22b35ec9dc43",
    "name": "Error Output",
    "category": "workflow",
    "subcategory": "end",
    "kind": "WORKFLOW_NODE_KIND_END",
    "description": "Ends this path of the run, recording the incoming error.",
    "control": { "in": ["in"], "out": [] },
    "dataIn": [
      { "name": "error", "label": "Error", "type": "error", "required": false }
    ],
    "exec": { "runsOn": "server", "effects": "WORKFLOW_EFFECTS_READ" }
  },
  {
    "type": "core/note",
    "id": "46c28876-69ca-4963-85ed-bc96f75fbf6e",
    "name": "Notes",
    "category": "workflow",
    "subcategory": "misc",
    "kind": "WORKFLOW_NODE_KIND_NOTE",
    "description": "An annotation. Has no ports, is stripped before compilation, and is excluded from validation.",
    "control": { "in": [], "out": [] },
    "settings": [
      { "name": "notes", "label": "Note", "type": "string", "default": "", "ui": { "widget": "textarea" } }
    ],
    "exec": { "runsOn": "server", "effects": "WORKFLOW_EFFECTS_READ" }
  },
  {
    "type": "core/conditional",
    "id": "6b32e34c-c356-4536-a073-9c40f0b4ec91",
    "name": "Check flow variable",
    "subcategory": "check",
    "kind": "WORKFLOW_NODE_KIND_BRANCH",
    "description": "Compares two values and takes the yes or no branch. The branches are control flow, not booleans — nothing downstream consumes them as data.",
    "control": { "in": ["in"], "out": ["yes", "no"], "error": true },
    "dataIn": [
      { "name": "input", "label": "Input", "type": "any", "required": false, "description": "Optional value under test, when the comparison operands reference it." }
    ],
    "settings": [
      { "name": "data1", "label": "Left", "type": "string", "default": "" },
      {
        "name": "operator",
        "label": "Operator",
        "type": "any",
        "default": "==",
        "ui": { "widget": "dropdown", "options": ["==", "!=", "contains", ">", "<", ">=", "<="] }
      },
      { "name": "data2", "label": "Right", "type": "string", "default": "" }
    ],
    "exec": { "runsOn": "server", "effects": "WORKFLOW_EFFECTS_READ" }
  },
  {
    "type": "media/trickplay",
    "id": "68c3a45b-da57-4e9c-a86b-0debf67b2ca9",
    "name": "Generate Trickplay",
    "subcategory": "function",
    "description": "Generates Jellyfin-compatible trickplay tiles beside the source video.",
    "control": { "in": ["in"], "out": ["next"], "error": true },
    "dataIn": [
      { "name": "source", "label": "Source file", "type": "any", "required": true }
    ],
    "dataOut": [
      { "name": "trickplayDir", "label": "Trickplay folder", "type": "path.dir" }
    ],
    "settings": [
      { "name": "width", "label": "Tile width", "type": "any", "default": 320 },
      { "name": "tileWidth", "label": "Tiles across", "type": "any", "default": 10 },
      { "name": "tileHeight", "label": "Tiles down", "type": "any", "default": 10 }
    ],
    "exec": {
      "runsOn": "agent",
      "agentSelector": "path",
      "timeout": "2h",
      "cancellable": true,
      "effects": "WORKFLOW_EFFECTS_WRITE",
      "retry": { "attempts": 3, "backoff": "30s" }
    }
  },
  {
    "type": "core/forEach",
    "id": "618d2ce0-738b-4e82-b0f0-e501f4fa9095",
    "name": "For Each",
    "category": "workflow",
    "subcategory": "control",
    "kind": "WORKFLOW_NODE_KIND_FOR_EACH",
    "description": "Runs the body once per item, then fires done. Both body and done come from this node, so the zero-iteration path exists in the graph.",
    "control": { "in": ["in"], "out": ["body", "done"], "error": true },
    "dataIn": [
      { "name": "collection", "label": "Collection", "type": "list<any>", "required": true }
    ],
    "dataOut": [
      { "name": "item", "label": "Item", "type": "any", "description": "The current item. Readable only inside the body. Its concrete type is inferred from the wired collection." },
      { "name": "index", "label": "Index", "type": "any", "description": "Zero-based position. Body-scoped." },
      { "name": "count", "label": "Count", "type": "any", "description": "Size of the whole collection." },
      { "name": "failedCount", "label": "Failed count", "type": "any", "description": "Items that failed under skip. Readable after done." }
    ],
    "settings": [
      { "name": "parallelism", "label": "Run at once", "type": "any", "default": 1 },
      {
        "name": "onItemError",
        "label": "On item error",
        "type": "any",
        "default": "abort",
        "ui": { "widget": "dropdown", "options": ["abort", "skip"] }
      }
    ],
    "exec": { "runsOn": "server", "effects": "WORKFLOW_EFFECTS_READ" }
  },
  {
    "type": "core/collect",
    "id": "d65e372d-b363-4718-9c65-0dfab07dbaed",
    "name": "Collect",
    "category": "workflow",
    "subcategory": "control",
    "kind": "WORKFLOW_NODE_KIND_COLLECT",
    "description": "Accumulates one value per iteration. Placed inside a loop body; its collected output is readable after the loop's done, in collection order.",
    "control": { "in": ["in"], "out": ["next"] },
    "dataIn": [
      { "name": "value", "label": "Value", "type": "any", "required": true }
    ],
    "dataOut": [
      { "name": "collected", "label": "Collected", "type": "list<any>", "description": "All collected values, in collection order. Element type is inferred from the wired value." }
    ],
    "exec": { "runsOn": "server", "effects": "WORKFLOW_EFFECTS_READ" }
  },
  {
    "type": "core/parallel",
    "id": "3fa05432-1000-4e6e-8367-6a24d3abb041",
    "name": "Parallel",
    "subcategory": "control",
    "category": "workflow",
    "kind": "WORKFLOW_NODE_KIND_PARALLEL",
    "description": "Runs its branches concurrently. Parallelism is always explicit — a second wire on one out-port is a validation error, never an implicit fork.",
    "control": {
      "in": ["in"],
      "out": ["branch1", "branch2", "branch3", "branch4", "branch5", "branch6", "branch7", "branch8"],
      "error": true
    },
    "settings": [
      { "name": "branches", "label": "Branches", "type": "any", "default": 2 },
      {
        "name": "onBranchError",
        "label": "On branch error",
        "type": "any",
        "default": "cancelSiblings",
        "ui": { "widget": "dropdown", "options": ["cancelSiblings", "waitForSiblings"] }
      }
    ],
    "exec": { "runsOn": "server", "effects": "WORKFLOW_EFFECTS_READ" }
  },
  {
    "type": "core/join",
    "id": "2c65816e-a7d8-4ee4-8217-b40437ab0d1e",
    "name": "Join",
    "subcategory": "control",
    "category": "workflow",
    "kind": "WORKFLOW_NODE_KIND_JOIN",
    "description": "Waits for every branch of its paired Parallel. Fires error instead of next if any branch failed.",
    "control": {
      "in": ["branch1", "branch2", "branch3", "branch4", "branch5", "branch6", "branch7", "branch8"],
      "out": ["next"],
      "error": true
    },
    "settings": [{ "name": "branches", "label": "Branches", "type": "any", "default": 2 }],
    "exec": { "runsOn": "server", "effects": "WORKFLOW_EFFECTS_READ" }
  },
  {
    "type": "core/break",
    "id": "f38ee5cf-20c6-4b40-827c-9687288d5b82",
    "name": "Break",
    "category": "workflow",
    "subcategory": "control",
    "kind": "WORKFLOW_NODE_KIND_BREAK",
    "description": "Ends the enclosing loop early and fires its done port. Legal only inside a loop body.",
    "control": { "in": ["in"], "out": [] },
    "exec": { "runsOn": "server", "effects": "WORKFLOW_EFFECTS_READ" }
  },
  {
    "type": "core/end",
    "id": "7e5ef826-a1fc-4300-a23f-5ed58ccece0b",
    "name": "End",
    "category": "workflow",
    "subcategory": "end",
    "kind": "WORKFLOW_NODE_KIND_END",
    "description": "Ends the run successfully. Forbidden inside parallel branches and loop bodies.",
    "control": { "in": ["in"], "out": [] },
    "exec": { "runsOn": "server", "effects": "WORKFLOW_EFFECTS_READ" }
  },
  {
    "type": "core/fail",
    "id": "b3832590-df95-4ff5-b06e-d4f7605142c6",
    "name": "Fail",
    "category": "workflow",
    "subcategory": "end",
    "kind": "WORKFLOW_NODE_KIND_FAIL",
    "description": "Ends the run as failed. Forbidden inside parallel branches and loop bodies.",
    "control": { "in": ["in"], "out": [] },
    "dataIn": [
      { "name": "message", "label": "Message", "type": "string", "required": false }
    ],
    "exec": { "runsOn": "server", "effects": "WORKFLOW_EFFECTS_READ" }
  },
  {
    "type": "fs/moveFile",
    "id": "31e09fea-bb13-4c83-8996-90ab10854380",
    "name": "Move File",
    "category": "agent",
    "subcategory": "filesystem",
    "description": "Moves a file to a new location, creating destination directories as needed.",
    "control": { "in": ["in"], "out": ["next"], "error": true },
    "dataIn": [
      { "name": "source", "label": "Source", "type": "path.file", "required": true },
      { "name": "destination", "label": "Destination", "type": "path.file", "required": true }
    ],
    "dataOut": [
      { "name": "movedTo", "label": "Moved to", "type": "path.file" }
    ],
    "exec": { "runsOn": "agent", "agentSelector": "path", "effects": "WORKFLOW_EFFECTS_WRITE", "retry": { "attempts": 2, "backoff": "5s" } }
  },
  {
    "type": "fs/copyFile",
    "id": "93c580a8-895a-4e5f-a97d-c903c7f077e1",
    "name": "Copy File",
    "category": "agent",
    "subcategory": "filesystem",
    "description": "Copies a file to a new location, leaving the source in place.",
    "control": { "in": ["in"], "out": ["next"], "error": true },
    "dataIn": [
      { "name": "source", "label": "Source", "type": "path.file", "required": true },
      { "name": "destination", "label": "Destination", "type": "path.file", "required": true }
    ],
    "dataOut": [
      { "name": "copiedTo", "label": "Copied to", "type": "path.file" }
    ],
    "exec": { "runsOn": "agent", "agentSelector": "path", "effects": "WORKFLOW_EFFECTS_WRITE", "retry": { "attempts": 2, "backoff": "5s" } }
  },
  {
    "type": "fs/deleteFile",
    "id": "053e1297-dee3-431a-9210-f0ee566328a2",
    "name": "Delete File",
    "category": "agent",
    "subcategory": "filesystem",
    "description": "Permanently removes a file. There is no undo.",
    "control": { "in": ["in"], "out": ["next"], "error": true },
    "dataIn": [
      { "name": "target", "label": "File", "type": "path.file", "required": true }
    ],
    "exec": { "runsOn": "agent", "agentSelector": "path", "effects": "WORKFLOW_EFFECTS_DESTRUCTIVE" }
  },
  {
    "type": "media/generateThumbnail",
    "id": "0ee12496-ce2d-43b2-98bc-0ab4377e6c33",
    "name": "Generate Thumbnail",
    "category": "agent",
    "subcategory": "media",
    "description": "Captures a single still frame from a video as an image file.",
    "control": { "in": ["in"], "out": ["next"], "error": true },
    "dataIn": [
      { "name": "source", "label": "Source file", "type": "any", "required": true }
    ],
    "dataOut": [
      { "name": "thumbnail", "label": "Thumbnail", "type": "any" }
    ],
    "settings": [
      { "name": "atSeconds", "label": "Capture at (seconds)", "type": "number", "default": 30 },
      { "name": "width", "label": "Width", "type": "any", "default": 640 }
    ],
    "exec": { "runsOn": "agent", "agentSelector": "path", "timeout": "1m", "effects": "WORKFLOW_EFFECTS_WRITE" }
  },
  {
    "type": "nfo/write",
    "id": "5c076327-da48-4179-9cb8-5ba507eb7912",
    "name": "Write NFO",
    "subcategory": "metadata",
    "description": "Writes structured metadata out to an NFO sidecar, overwriting it if present.",
    "control": { "in": ["in"], "out": ["next"], "error": true },
    "dataIn": [
      { "name": "metadata", "label": "Metadata", "type": "any", "required": true },
      { "name": "target", "label": "NFO file", "type": "any", "required": true }
    ],
    "dataOut": [
      { "name": "written", "label": "Written to", "type": "any" }
    ],
    "exec": { "runsOn": "agent", "agentSelector": "path", "effects": "WORKFLOW_EFFECTS_WRITE" }
  }
  ]
}
