<div class="toolbar" role="navigation">
{{> nav-toggle}}
  {{#with site.homeUrl}}
  <a href="{{{relativize this}}}" class="home-link{{#if @root.page.home}} is-current{{/if}}"></a>
  {{/with}}
{{> breadcrumbs}}
{{> page-versions}}
{{> edit-this-page}}
  <label class="widescreen-toggle-label" title="Toggle widescreen mode">
    <input type="checkbox" id="widescreen-toggle" class="widescreen-toggle">
    <span class="widescreen-toggle-icon"></span>
  </label>
</div>

<script>
(function() {
  const toggle = document.getElementById('widescreen-toggle');
  const cookieName = 'metarr-widescreen-mode';

  function setCookie(value) {
    document.cookie = `${cookieName}=${value}; path=/; max-age=31536000`;
  }

  function getCookie() {
    return document.cookie.split('; ').find(row => row.startsWith(cookieName + '='))?.split('=')[1] === 'true';
  }

  function restoreState() {
    toggle.checked = getCookie();
  }

  toggle.addEventListener('change', function() {
    setCookie(this.checked);
  });

  restoreState();
})();
</script>
