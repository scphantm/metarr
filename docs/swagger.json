{
    "swagger": "2.0",
    "info": {
        "description": "Event-driven Go API backed by MongoDB and Redis. Every request carries a correlation ID (X-Correlation-ID), generated by the server if the caller doesn't supply one.",
        "title": "Metarr API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/config": {
            "get": {
                "description": "Reads the singleton application config document from MongoDB.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Config"
                ],
                "summary": "Fetch the application config",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/Metarr_internal_appconfig.Config"
                        }
                    }
                }
            },
            "put": {
                "description": "Fires a system_config_update event with the updated document as its payload and returns as soon as the event has been queued. The SystemConfigUpdate listener persists the change to MongoDB and then refreshes the in-memory config singleton.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Config"
                ],
                "summary": "Update the application config",
                "parameters": [
                    {
                        "description": "Updated application config",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/Metarr_internal_appconfig.Config"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.acceptedResponse"
                        }
                    },
                    "400": {
                        "description": "invalid request body",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/heartbeat": {
            "get": {
                "description": "Publishes a heartbeat request on the Redis Pub/Sub queue and blocks until the heartbeat listener replies with the current time and the request's correlation ID.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Heartbeat"
                ],
                "summary": "Blocking heartbeat check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.HeartbeatResponse"
                        }
                    },
                    "504": {
                        "description": "heartbeat timed out",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/tasks/sonarr_cache_data": {
            "post": {
                "description": "Fires the sonarr_cache_data event onto the durable event stream in a non-blocking way and returns as soon as the event has been queued.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Tasks"
                ],
                "summary": "Trigger the sonarr_cache_data background job",
                "parameters": [
                    {
                        "description": "Command to run",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.taskRequest"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.acceptedResponse"
                        }
                    },
                    "400": {
                        "description": "invalid request body or unsupported command",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "Metarr_internal_appconfig.Config": {
            "type": "object",
            "properties": {
                "interfaces": {
                    "$ref": "#/definitions/Metarr_internal_appconfig.InterfacesConfig"
                }
            }
        },
        "Metarr_internal_appconfig.InterfacesConfig": {
            "type": "object",
            "properties": {
                "sonarr": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Metarr_internal_appconfig.SonarrInstance"
                    }
                }
            }
        },
        "Metarr_internal_appconfig.RootDirMapping": {
            "type": "object",
            "properties": {
                "local_path": {
                    "type": "string"
                },
                "sonarr_path": {
                    "type": "string"
                }
            }
        },
        "Metarr_internal_appconfig.SonarrInstance": {
            "type": "object",
            "properties": {
                "instance_name": {
                    "type": "string"
                },
                "instance_slug": {
                    "type": "string"
                },
                "root_dir_map": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Metarr_internal_appconfig.RootDirMapping"
                    }
                },
                "sonarr_api_key": {
                    "type": "string"
                },
                "sonarr_url": {
                    "type": "string"
                },
                "storage": {
                    "$ref": "#/definitions/Metarr_internal_appconfig.StorageConfig"
                }
            }
        },
        "Metarr_internal_appconfig.StorageConfig": {
            "type": "object",
            "properties": {
                "mode": {
                    "type": "string"
                },
                "ttl": {
                    "type": "string"
                }
            }
        },
        "internal_handlers.HeartbeatResponse": {
            "type": "object",
            "properties": {
                "correlation_id": {
                    "type": "string"
                },
                "time": {
                    "type": "string"
                }
            }
        },
        "internal_handlers.acceptedResponse": {
            "type": "object",
            "properties": {
                "correlation_id": {
                    "type": "string"
                },
                "event": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "internal_handlers.taskRequest": {
            "type": "object",
            "properties": {
                "command": {
                    "type": "string"
                }
            }
        }
    }
}