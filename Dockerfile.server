# metarr-server is the API, the database and the orchestration. It mounts no
# media: every filesystem operation happens on an agent, which is the point of
# the split. The UI (see ui/embed.go) is embedded into the binary at build time
# with the embed_ui build tag; the assets are built in the ui-build stage below.

FROM node:22-alpine AS ui-build

WORKDIR /src/ui

COPY ui/package.json ui/package-lock.json ./
RUN npm ci

COPY ui/ ./
RUN npm run build

FROM golang:1.26-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
COPY --from=ui-build /src/ui/dist ./ui/dist

ARG VERSION=dev
ARG TARGETOS
ARG TARGETARCH

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go build -trimpath -tags embed_ui -ldflags "-s -w -X Metarr/internal/shared/version.Raw=${VERSION}" \
    -o /out/metarr-server ./cmd/metarr-server

FROM alpine:3.21

# The server talks to MongoDB and Redis over TLS in any real deployment, and
# unlike the agent it is worth keeping a shell here for diagnosing a live
# system.
RUN apk add --no-cache ca-certificates tzdata \
    && adduser -D -u 10001 metarr

COPY --from=build /out/metarr-server /usr/local/bin/metarr-server

USER metarr
WORKDIR /app

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/metarr-server"]
