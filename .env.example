# Copy this file to .env and adjust before running `docker compose up`.
# These values seed the MongoDB root account and must match the
# credentials the init script (mongo/init/init-mongo.js) grants to the
# "app" and "readonly" application users, and that config.yaml connects
# with.

MONGO_INITDB_ROOT_USERNAME=metarr
MONGO_INITDB_ROOT_PASSWORD=change-me-root-password

MONGO_APP_USERNAME=app
MONGO_APP_PASSWORD=apppassword

MONGO_READONLY_USERNAME=readonly
MONGO_READONLY_PASSWORD=readonlypassword

MONGO_DATABASE=metarr
