# Copy this file to .env and adjust before running `docker compose up`.
#
# These environment variables configure external integrations, Docker services,
# and the application runtime. Values set here are used by docker-compose.yml,
# the Go server and agent, and seed services like MongoDB and OpenObserve.

# === Metarr Server Configuration ===

# Path to the Metarr application config file (YAML). The server reads this
# on startup. Relative paths are resolved from the repo root.
# Tip: Use config/server.local.yaml for localhost connections to docker-compose services;
# use config/server.yaml for container-internal networking (mongodb, redis hostnames).
METARR_CONFIG_FILE=config/server.local.yaml

# === MongoDB (Application Database) ===

# MongoDB root superuser credentials. Used to initialize the database on first start.
# These are consumed by config/mongo-init.js, which creates application users.
# MUST be changed for production.
MONGO_INITDB_ROOT_USERNAME=metarr
MONGO_INITDB_ROOT_PASSWORD=change-me-root-password

# MongoDB "app" user: the account the Metarr server uses to connect to MongoDB.
# This user is created by the init script with permissions to read/write the metarr database.
# Must match the credentials in config/server.yaml / config/server.local.yaml under mongodb.app_*.
MONGO_APP_USERNAME=metarr
MONGO_APP_PASSWORD=change-me-app-password

# MongoDB "readonly" user: a restricted account for read-only database access.
# Can be used by reporting/analytics tools that don't need write access.
MONGO_READONLY_USERNAME=readonly
MONGO_READONLY_PASSWORD=change-me-readonly-password

# The MongoDB database name where Metarr stores its data (config, workflows, scans, etc.).
# This database is created by the init script.
MONGO_DATABASE=metarr

# === Redis (Event Bus & Caching) ===

# Redis authentication password. The server and agents connect to Redis to publish/subscribe
# to events (scans, config changes, etc.). Must match the password in config/server.yaml / config/server.local.yaml.
# Redis is used for inter-component communication, not data persistence.
REDIS_PASSWORD=change-me-redis-password

# === OpenObserve (Logging & Observability) ===

# OpenObserve root user email. Used to log into the OpenObserve web UI (http://localhost:5080).
OPENOBSERVE_ROOT_EMAIL=admin@example.com

# OpenObserve root user password. MUST satisfy OpenObserve's password policy:
# 8-128 characters, at least one uppercase letter, one lowercase, one digit, and one special character.
# Examples: Metarr123!, MyPass#2024
# The container will refuse to start with a weak password.
OPENOBSERVE_ROOT_PASSWORD=change-me-1!

# OpenObserve organization name (namespace for logs and streams).
OPENOBSERVE_ORG=default

# OpenObserve stream name where Metarr logs are stored.
# Logs from metarr-server and metarr-agent are forwarded here via Fluent Bit.
OPENOBSERVE_STREAM=metarr_app
