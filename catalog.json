      { "name": "media", "label": "Media Record", "type": "media", "description": "The media record." }
    ],
    "settings": [
      {
        "name": "trigger",
        "label": "Trigger",
        "type": "any",
        "default": "manual",
        "ui": { "widget": "dropdown", "options": ["manual", "schedule", "scanComplete"] },
        "description": "What starts this workflow. Only manual is honoured today; the rest are reserved."
      }
    ],
    "exec": { "runsOn": "server", "effects": "read" }
  },
  {
    "type": "core/writeChanges",
    "id": "cc45bcdf-48be-466f-9bbf-d4c74da3b05f",
    "name": "Write changes",
    "category": "workflow",
    "subcategory": "end",
    "kind": "end",
    "description": "Commits pending changes and ends this path of the run.",
    "control": { "in": ["in"], "out": [], "error": true },
    "exec": { "runsOn": "server", "effects": "write" }
  },
  {
    "type": "core/errorOutput",
