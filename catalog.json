[
  {
    "type": "core/start",
    "id": "72f8e409-bf15-4dd6-ab8c-70a2ec512ec7",
    "name": "Start Path",
    "category": "workflow",
    "subcategory": "start",
    "kind": "start",
    "description": "Where the run begins. The input type of this is path, which translates to a file on a drive",
    "control": { "in": [], "out": ["next"] },
    "dataOut": [
      { "name": "path", "label": "Path", "type": "path", "description": "The configured path." }
    ],
    "settings": [
      {
        "name": "trigger",
        "label": "Trigger",
        "type": "any",
        "default": "manual",
        "ui": { "widget": "dropdown", "options": ["manual", "schedule", "scanComplete"] },
        "description": "What starts this workflow. Only manual is honoured today; the rest are reserved."
      }
    ],
    "exec": { "runsOn": "server", "effects": "read" }
  },
  {
    "type": "core/start",
    "id": "df1084cd-e619-4af2-9214-048898acc479",
    "name": "Start Media",
    "category": "workflow",
    "subcategory": "start",
