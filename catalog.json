  {
    "type": "core/note",
    "id": "46c28876-69ca-4963-85ed-bc96f75fbf6e",
    "name": "Notes",
    "category": "workflow",
    "subcategory": "misc",
    "kind": "note",
    "description": "An annotation. Has no ports, is stripped before compilation, and is excluded from validation.",
    "control": { "in": [], "out": [] },
    "settings": [
      { "name": "notes", "label": "Note", "type": "string", "default": "", "ui": { "widget": "textarea" } }
    ],
    "exec": { "runsOn": "server", "effects": "read" }
  },
  {
    "type": "core/checkFlowVariable",
    "id": "6b32e34c-c356-4536-a073-9c40f0b4ec91",
    "name": "Check flow variable",
    "subcategory": "check",
    "kind": "branch",
    "description": "Compares two values and takes the yes or no branch. The branches are control flow, not booleans — nothing downstream consumes them as data.",
    "control": { "in": ["in"], "out": ["yes", "no"], "error": true },
    "dataIn": [
      { "name": "input", "label": "Input", "type": "any", "required": false, "description": "Optional value under test, when the comparison operands reference it." }
    ],
    "settings": [
      { "name": "data1", "label": "Left", "type": "string", "default": "" },
      {
        "name": "operator",
        "label": "Operator",
        "type": "any",
        "default": "==",
        "ui": { "widget": "dropdown", "options": ["==", "!=", "contains", ">", "<", ">=", "<="] }
      },
      { "name": "data2", "label": "Right", "type": "string", "default": "" }
    ],
    "exec": { "runsOn": "server", "effects": "read" }
  },
  {
    "type": "core/trickplay",
    "id": "68c3a45b-da57-4e9c-a86b-0debf67b2ca9",
    "name": "Generate Trickplay",
    "subcategory": "function",
    "description": "Generates Jellyfin-compatible trickplay tiles beside the source video.",
    "control": { "in": ["in"], "out": ["next"], "error": true },
    "dataIn": [
      { "name": "source", "label": "Source file", "type": "any", "required": true }
    ],
    "dataOut": [
      { "name": "trickplayDir", "label": "Trickplay folder", "type": "path.dir" }
    ],
    "settings": [
      { "name": "width", "label": "Tile width", "type": "any", "default": 320 },
      { "name": "tileWidth", "label": "Tiles across", "type": "any", "default": 10 },
      { "name": "tileHeight", "label": "Tiles down", "type": "any", "default": 10 }
    ],
    "exec": {
      "runsOn": "agent",
      "agentSelector": "path",
      "timeout": "2h",
      "cancellable": true,
      "effects": "write",
      "retry": { "attempts": 3, "backoff": "30s" }
    }
  },
  {
    "type": "core/forEach",
    "id": "618d2ce0-738b-4e82-b0f0-e501f4fa9095",
    "name": "For Each",
    "category": "workflow",
    "subcategory": "control",
    "kind": "forEach",
    "description": "Runs the body once per item, then fires done. Both body and done come from this node, so the zero-iteration path exists in the graph.",
    "control": { "in": ["in"], "out": ["body", "done"], "error": true },
    "dataIn": [
      { "name": "collection", "label": "Collection", "type": "list<any>", "required": true }
    ],
    "dataOut": [
      { "name": "item", "label": "Item", "type": "any", "description": "The current item. Readable only inside the body. Its concrete type is inferred from the wired collection." },
      { "name": "index", "label": "Index", "type": "any", "description": "Zero-based position. Body-scoped." },
      { "name": "count", "label": "Count", "type": "any", "description": "Size of the whole collection." },
      { "name": "failedCount", "label": "Failed count", "type": "any", "description": "Items that failed under skip. Readable after done." }
    ],
    "settings": [
      { "name": "parallelism", "label": "Run at once", "type": "any", "default": 1 },
      {
        "name": "onItemError",
        "label": "On item error",
        "type": "any",
        "default": "abort",
        "ui": { "widget": "dropdown", "options": ["abort", "skip"] }
      }
    ],
    "exec": { "runsOn": "server", "effects": "read" }
  },
  {
    "type": "core/collect",
    "id": "d65e372d-b363-4718-9c65-0dfab07dbaed",
    "name": "Collect",
    "category": "workflow",
    "subcategory": "control",
    "kind": "collect",
    "description": "Accumulates one value per iteration. Placed inside a loop body; its collected output is readable after the loop's done, in collection order.",
    "control": { "in": ["in"], "out": ["next"] },
    "dataIn": [
      { "name": "value", "label": "Value", "type": "any", "required": true }
    ],
    "dataOut": [
      { "name": "collected", "label": "Collected", "type": "list<any>", "description": "All collected values, in collection order. Element type is inferred from the wired value." }
    ],
    "exec": { "runsOn": "server", "effects": "read" }
  },
  {
    "type": "core/parallel",
    "id": "3fa05432-1000-4e6e-8367-6a24d3abb041",
    "name": "Parallel",
    "subcategory": "control",
    "category": "workflow",
    "kind": "parallel",
    "description": "Runs its branches concurrently. Parallelism is always explicit — a second wire on one out-port is a validation error, never an implicit fork.",
    "control": {
      "in": ["in"],
      "out": ["branch1", "branch2", "branch3", "branch4", "branch5", "branch6", "branch7", "branch8"],
      "error": true
    },
    "settings": [
      { "name": "branches", "label": "Branches", "type": "any", "default": 2 },
      {
        "name": "onBranchError",
        "label": "On branch error",
        "type": "any",
        "default": "cancelSiblings",
        "ui": { "widget": "dropdown", "options": ["cancelSiblings", "waitForSiblings"] }
      }
    ],
    "exec": { "runsOn": "server", "effects": "read" }
  },
  {
    "type": "core/join",
    "id": "2c65816e-a7d8-4ee4-8217-b40437ab0d1e",
    "name": "Join",
    "subcategory": "control",
    "category": "workflow",
    "kind": "join",
    "description": "Waits for every branch of its paired Parallel. Fires error instead of next if any branch failed.",
    "control": {
      "in": ["branch1", "branch2", "branch3", "branch4", "branch5", "branch6", "branch7", "branch8"],
      "out": ["next"],
      "error": true
    },
    "settings": [{ "name": "branches", "label": "Branches", "type": "any", "default": 2 }],
    "exec": { "runsOn": "server", "effects": "read" }
  },
  {
    "type": "core/break",
    "id": "f38ee5cf-20c6-4b40-827c-9687288d5b82",
    "name": "Break",
    "category": "workflow",
    "subcategory": "control",
    "kind": "break",
    "description": "Ends the enclosing loop early and fires its done port. Legal only inside a loop body.",
    "control": { "in": ["in"], "out": [] },
    "exec": { "runsOn": "server", "effects": "read" }
  },
  {
    "type": "core/end",
    "id": "7e5ef826-a1fc-4300-a23f-5ed58ccece0b",
    "name": "End",
    "category": "workflow",
    "subcategory": "end",
    "kind": "end",
    "description": "Ends the run successfully. Forbidden inside parallel branches and loop bodies.",
    "control": { "in": ["in"], "out": [] },
    "exec": { "runsOn": "server", "effects": "read" }
  },
  {
    "type": "core/fail",
    "id": "b3832590-df95-4ff5-b06e-d4f7605142c6",
    "name": "Fail",
    "category": "workflow",
    "subcategory": "end",
    "kind": "fail",
    "description": "Ends the run as failed. Forbidden inside parallel branches and loop bodies.",
    "control": { "in": ["in"], "out": [] },
    "dataIn": [
      { "name": "message", "label": "Message", "type": "string", "required": false }
    ],
    "exec": { "runsOn": "server", "effects": "read" }
  },
