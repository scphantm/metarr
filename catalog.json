  {
    "type": "string/format",
    "id": "7ee07308-1c52-457c-b1de-6c1ece67d3ff",
    "name": "Format String",
    "subcategory": "string",
    "description": "Substitutes wired values into a template string, e.g. \"{value1} ({value2})\".",
    "control": { "in": ["in"], "out": ["next"] },
    "dataIn": [
      { "name": "value1", "label": "Value 1", "type": "any", "required": false },
      { "name": "value2", "label": "Value 2", "type": "any", "required": false }
    ],
    "dataOut": [
      { "name": "result", "label": "Result", "type": "string" }
    ],
    "settings": [
      { "name": "template", "label": "Template", "type": "string", "default": "", "description": "Use {value1}, {value2} as placeholders." }
    ],
    "exec": { "runsOn": "server", "effects": "read" }
  },
  {
    "type": "string/regexMatch",
    "id": "a72025a1-41b4-469b-907b-b0034c73901a",
    "name": "Regex Match",
    "subcategory": "string",
    "kind": "branch",
    "description": "Tests a string against a regular expression and takes the matched or unmatched branch.",
    "control": { "in": ["in"], "out": ["matched", "unmatched"], "error": true },
    "dataIn": [
      { "name": "input", "label": "Input", "type": "string", "required": true }
    ],
    "dataOut": [
      { "name": "match", "label": "Matched text", "type": "string", "description": "The first match, or the first capture group if the pattern has one. Readable only on the matched branch." }
    ],
    "settings": [
      { "name": "pattern", "label": "Pattern", "type": "string", "default": "" }
    ],
    "exec": { "runsOn": "server", "effects": "read" }
  },
  {
    "type": "string/concat",
    "id": "fc10ec6d-fe31-4922-bfa2-c7138221a76d",
    "name": "Concatenate",
    "subcategory": "string",
    "description": "Joins two strings with an optional separator.",
    "control": { "in": ["in"], "out": ["next"] },
    "dataIn": [
      { "name": "left", "label": "Left", "type": "string", "required": true },
      { "name": "right", "label": "Right", "type": "string", "required": true }
    ],
    "dataOut": [
      { "name": "result", "label": "Result", "type": "string" }
    ],
    "settings": [
      { "name": "separator", "label": "Separator", "type": "string", "default": "" }
    ],
    "exec": { "runsOn": "server", "effects": "read" }
  },
  {
    "type": "string/parseNumber",
    "id": "48b4ef68-2b41-417d-a26a-e8d6f06afd8d",
    "name": "Parse Number",
    "subcategory": "string",
    "kind": "branch",
    "description": "Parses text as a number and takes the parsed or failed branch, for when the value needs branching on rather than just wiring through the parseNumber transform.",
    "control": { "in": ["in"], "out": ["parsed", "failed"] },
    "dataIn": [
      { "name": "input", "label": "Input", "type": "string", "required": true }
    ],
    "dataOut": [
      { "name": "value", "label": "Value", "type": "number", "description": "Readable only on the parsed branch." }
    ],
    "exec": { "runsOn": "server", "effects": "read" }
  },
  {
    "type": "string/trim",
    "id": "be0d4299-2cee-49a8-ac9c-709aa927b223",
    "name": "Trim",
    "subcategory": "string",
    "description": "Removes leading and trailing whitespace from a string.",
    "control": { "in": ["in"], "out": ["next"] },
    "dataIn": [
      { "name": "input", "label": "Input", "type": "string", "required": true }
    ],
    "dataOut": [
      { "name": "result", "label": "Result", "type": "string" }
    ],
    "exec": { "runsOn": "server", "effects": "read" }
  }
]
